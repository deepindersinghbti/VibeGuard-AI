# Gemini API key for AI explanations.
# Do not commit your real key. Copy this file to backend/.env for local notes,
# or set GEMINI_API_KEY in your shell before starting the backend.
GEMINI_API_KEY=

# Optional: override the default model used for explanations.
GEMINI_MODEL=gemini-2.5-flash

# CORS origins allowed by the backend (comma-separated).
# Always includes http://localhost:3000, http://localhost:5173, http://127.0.0.1:3000 for local dev.
# Example for production:
# CORS_ORIGINS=http://localhost:3000,https://vibeguard-five.vercel.app
